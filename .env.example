# NOFX Environment Variables Template
# Copy this file to .env and fill required values.

# ===========================================
# Server
# ===========================================
NOFX_BACKEND_PORT=8080
NOFX_FRONTEND_PORT=3000
NOFX_TIMEZONE=Asia/Shanghai

# ===========================================
# Required Security
# ===========================================
# Generate: openssl rand -base64 32
JWT_SECRET=replace-with-random-jwt-secret

# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Generate: openssl genrsa -traditional 2048
# Keep it one line and replace line breaks with \n
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----
TRANSPORT_ENCRYPTION=false

# ===========================================
# Super Admin Bootstrap (created/ensured at startup)
# ===========================================
NOFX_SUPER_ADMIN_EMAIL=admin@example.com
NOFX_SUPER_ADMIN_PASSWORD=A123456b@!

# ===========================================
# Database (default: SQLite)
# ===========================================
DB_TYPE=sqlite
DB_PATH=data/data.db

# Optional PostgreSQL (uncomment when needed)
# DB_TYPE=postgres
# DB_HOST=host.docker.internal
# DB_PORT=5432
# DB_USER=nofx_user
# DB_PASSWORD=replace-with-db-password
# DB_NAME=nofx
# DB_SSLMODE=disable

# Scheduled backup (SQLite only)
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_MINUTES=60
# Docker recommended: /app/backups
# Non-Docker local run can use: data/backups
DB_BACKUP_DIR=/app/backups
DB_BACKUP_RETENTION_DAYS=3
DB_BACKUP_ON_STARTUP=true
# Host backup directory (for docker compose volume mapping)
NOFX_DB_BACKUP_HOST_DIR=./backups

# Payment order reconcile (auto-fix stale unpaid orders)
PAYMENT_RECONCILE_ENABLED=true
PAYMENT_RECONCILE_INTERVAL_SECONDS=60
PAYMENT_RECONCILE_STALE_MINUTES=2
PAYMENT_RECONCILE_BATCH_SIZE=50

# ===========================================
# Optional
# ===========================================
API_SERVER_PORT=8080
AI_MAX_TOKENS=8000
REGISTRATION_ENABLED=true
MAX_USERS=10

# Backtest showcase (optional): set an email to expose this account's backtest runs to all logged-in users
NOFX_BACKTEST_SHOWCASE_EMAIL=
# Deprecated fallback (prefer email):
NOFX_BACKTEST_SHOWCASE_USER_ID=

# SMTP (required for forgot-password email verification)
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_USER=newmoneyclub@126.com
SMTP_PASSWORD=
SMTP_FROM=newmoneyclub@126.com
